# ==========================================
# R Specifics
# ==========================================
# History files
.Rhistory
.Rapp.history
# Session Data files
.RData
.RDataTmp
# User-specific files
.Ruserdata
# Example code in package build process
*-Ex.R
# Output files from R CMD build
/*.tar.gz
# Output files from R CMD check
/*.Rcheck/
# RStudio files
.Rproj.user/
# produced vignettes
vignettes/*.html
vignettes/*.pdf
# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth
# knitr and R markdown default cache directories
*_cache/
/cache/
# Temporary files created by R markdown
*.utf8.md
*.knit.md
# R Environment Variables
.Renviron
# pkgdown site
docs/**
!docs/**/
!docs/**/*.md
# translation temp files
po/*~
# RStudio Connect folder
rsconnect/
# ==========================================
# Jupyter Notebook Specifics
# ==========================================
# Ignore the autosave and checkpoint directories generated by Jupyter
.ipynb_checkpoints
*/.ipynb_checkpoints/*
# Ignore exported notebook formats if you do not want to track them
*.html
*.pdf
# Rendered Quarto HTML stays untracked - it is reproducible from the .qmd source
# and each self-contained render is ~2 MB, which would bloat history quickly.
# Final PDF deliverables (posters, submitted reports) are committed deliberately.
!reports/**/*.pdf
# ==========================================
# Python Runtime & Build Artifacts
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
# ==========================================
# Virtual Environments (Local setups)
# ==========================================
.venv/
venv/
env/
ENV/
renv/library/
renv/staging/
# ==========================================
# Data & Large Files
# ==========================================
# Bulk and derived data live on disk, not in git. Keep the directories
# themselves so scripts that write into them work on a fresh clone.
data/external/*
data/interim/*
data/processed/*
data/raw/*
!data/external/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/raw/.gitkeep
# Data-shaped json anywhere under data/ (config json elsewhere stays tracked)
data/**/*.json
# Runtime artifacts, repo-wide
*.log
*.sqlite
# ==========================================
# Environments and Secrets
# ==========================================
.env
.secrets


# Claude Code machine-local settings
.claude/settings.local.json

# ==========================================
# Private Planning Notes
# ==========================================
# Working notes and implementation bookkeeping, not part of the published record
planning/
